# Copy this file to .env and fill in your MySQL credentials.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=surgical_scheduling

# --- HTTP server ---
PORT=3000

# --- Auth ---
# Any long random string. Change this before deploying anywhere real.
JWT_SECRET=change-me-to-a-long-random-string

# --- Demo password used by scripts/gen-auth-sql.js ---
DEMO_PASSWORD=demo1234
