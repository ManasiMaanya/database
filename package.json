{
  "name": "surgical-scheduling",
  "version": "1.0.0",
  "description": "Surgical Scheduling and Dependency Management System - Express + MySQL backend for the Review 1/2 database design",
  "type": "commonjs",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
